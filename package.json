{
  "name": "lyricfren",
  "private": true,
  "packageManager": "yarn@4.9.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "scripts": {
    "dev": "concurrently \"yarn workspace frontend dev\" \"yarn workspace server start\"",
    "build": "yarn workspaces foreach --topological run build",
    "clean": "yarn workspaces foreach run clean"
  }
}
