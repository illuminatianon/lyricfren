{
  "name": "lyricfren",
  "private": true,
  "packageManager": "yarn@4.9.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "concurrently": "^8.2.2",
    "wait-on": "^8.0.3"
  },
  "scripts": {
    "dev": "concurrently -k -n backend,frontend -c blue,green \"yarn workspace server dev\" \"yarn workspace frontend dev\"",
    "build": "yarn workspaces foreach --topological run build",
    "clean": "yarn workspaces foreach run clean"
  }
}
