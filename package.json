{
  "name": "lyricfren",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "concurrently": "^8.2.2",
    "wait-on": "^8.0.3"
  },
  "scripts": {
    "dev": "pnpm --filter lyricfren-desktop run dev",
    "build": "pnpm recursive --parallel --sort run build --no-bail",
    "clean": "pnpm recursive --parallel run clean",
    "dev:desktop": "pnpm --filter lyricfren-desktop dev",
    "build:desktop": "pnpm --filter lyricfren-desktop build"
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {}
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "electron",
      "esbuild",
      "vue-demi"
    ]
  }
}
