{
  "name": "lyricfren",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "concurrently": "^8.2.2",
    "wait-on": "^8.0.3"
  },
  "scripts": {
    "dev": "concurrently -k -n backend,frontend -c blue,green \"pnpm --filter server dev\" \"pnpm --filter frontend dev\"",
    "build": "pnpm recursive --parallel --sort run build --no-bail",
    "clean": "pnpm recursive --parallel run clean"
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {}
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "vue-demi"
    ]
  }
}
